# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key (required in production; any long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 ONLY while developing locally (enables the debugger)
FLASK_DEBUG=0

# Set to 1 when the app runs behind HTTPS (marks the session cookie Secure)
COOKIE_SECURE=0

# Admin account, created with: python create_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_EMAIL=admin@example.com

# Email (SMTP) for password reset links. Leave SMTP_HOST empty to disable
# email; the app will then show "Contact the admin to reset your password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
